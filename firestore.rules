/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes rapid prototyping by focusing on authorization and skipping schema validation.
 * It uses a flexible "owner-based" access control model for user-specific data and a public-read/owner-write model for some top-level collections.
 *
 * Data Structure:
 * - /tickets/{ticketId}: Stores ticket information, globally accessible for reading.
 * - /users/{userId}: Stores user profile information, with owner-only write access.
 * - /departments/{departmentId}: Stores department information, globally accessible for reading.
 * - /subjects/{subjectId}: Stores ticket subjects, globally accessible for reading.
 * - /system-logs/{logId}: Stores system logs, only readable by admins.
 *
 * Key Security Decisions:
 * - Public Read Access: The 'tickets', 'departments', and 'subjects' collections are publicly readable to facilitate initial development.
 * - Owner-Only Write Access:  Write operations for user profiles are restricted to the owning user.
 * - Admin-Only Access: The 'system-logs' collection is only readable by admins.
 *
 * Denormalization for Authorization:
 * - The 'tickets' collection utilizes the `createdBy.userId` field to enforce owner-only updates and deletes.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /tickets/{ticketId} {
      allow read: if true;
      allow create: if true;
      allow update: if isTicketEditor();
      allow delete: if isSignedIn() && (
        (('createdBy' in resource.data) && request.auth.uid == resource.data.createdBy.userId) ||
        isAdmin()
      );
    }

    // Lightweight read-only mirror of /tickets used by the list pages.
    // Written only by the mirrorTicketSummary Cloud Function / backfill (Admin SDK).
    // Same read access as /tickets; no client writes.
    match /ticket_summaries/{ticketId} {
      allow read: if true;
      allow write: if false;
    }

    // Deletion markers for ticket_summaries (fast-load clients remove these ids). Admin SDK only.
    match /ticket_summaries_deleted/{ticketId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow get, list: if true;
      allow create: if isOwner(userId) && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }
    match /divisions/{divisionId} {
      allow get, list: if true;
  allow create, update, delete: if isAdmin();
    }
    match /official_holidays/{holidayId} {
  allow get, list: if isSignedIn();
  allow create, update, delete: if isAdmin();
}
  match /settings/{settingId} {
      allow get, list: if true;
  allow create, update, delete: if isAdmin();
} 
    match /departments/{departmentId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
		 match /settings_tags/{tagsId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /grades/{gradeId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Settings > Email Configurations. Read by staff for scope pickers; written only by
    // server actions (Admin SDK) and the Cloud Functions sync status.
    match /mailboxes/{mailboxId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }
    match /campuses/{campusId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /system-logs/{logId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /mail/{mailId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    match /ticket-events/{ticketEventId} {
      allow create: if true;
      allow read, update: if isSignedIn() && request.auth.uid == resource.data.recipient;
      allow delete: if false;
    }
match /ticket-transfers/{transferId} {
  allow get, list: if isSignedIn();
  allow create: if isSignedIn();
  allow update, delete: if isAdmin();
}
    match /work-sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    function isTicketEditor() {
      return isSignedIn() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            (
              ('createdBy' in resource.data) &&
              request.auth.uid == resource.data.createdBy.userId
            ) ||
            (
              ('assignedTo' in resource.data) &&
              resource.data.assignedTo != null &&
              request.auth.uid == resource.data.assignedTo.userId
            ) ||
            (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Manager' &&
              ('departmentId' in resource.data) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.departmentId == resource.data.departmentId
            )
          )
        )
      );
    }
  }
}